  (gr_rect (start 0 0) (end 160 100) (layer "Edge.Cuts") (stroke (width 0.15) (type solid)))
  (gr_text "ANIMA MAINBOARD v1.0 - 51 CH PWM CONTROLLER" (at 80 8) (layer "F.SilkS") (effects (font (size 2.5 2.5) (thickness 0.4))))
  (gr_text "Designed by Abhishek A S | ESP32-S3 | 6V 35A Rail" (at 80 14) (layer "F.SilkS") (effects (font (size 1.5 1.5) (thickness 0.25))))
